# Solo configuración local del piloto; NO copiar claves de servicios reales.
APP_MODE=pilot
PORT=8080
FRONTEND_ORIGIN=http://localhost:5173
PUBLIC_URL=http://localhost:5173
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=foxbus
MYSQL_PASSWORD=
MYSQL_DATABASE=foxbus_pilot
MYSQL_TIMEOUT_MS=60000
EXPIRATION_JOB_INTERVAL_MS=1000
# npm run pilot fija la base independiente foxbus_pilot (nunca la de ventas).
# Para crear personal, definir fuera de Git una identidad ficticia y contraseña propia:
# FOXBUS_ADMIN_EMAIL=coordinador@example.test
# FOXBUS_ADMIN_PASSWORD=
# FOXBUS_ADMIN_NAME=Coordinador del piloto
