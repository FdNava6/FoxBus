{
  "name": "foxbus-backend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "pilot": "node --env-file-if-exists=.env.pilot src/pilot.js",
    "pilot:admin": "node --env-file-if-exists=.env.pilot src/pilot.js admin",
    "pilot:doctor": "node --env-file-if-exists=.env.pilot src/pilot.js doctor",
    "pilot:report": "node --env-file-if-exists=.env.pilot src/pilot.js pilot-report",
    "pilot:backup": "node --env-file-if-exists=.env.pilot src/pilot.js backup",
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "test": "node --env-file-if-exists=.env --test",
    "expire": "node --env-file-if-exists=.env src/jobs/expire-reservations.js",
    "admin": "node --env-file-if-exists=.env src/cli.js admin",
    "backup": "node --env-file-if-exists=.env src/cli.js backup",
    "doctor": "node --env-file-if-exists=.env src/cli.js doctor",
    "restore": "node --env-file-if-exists=.env src/cli.js restore",
    "retention:report": "node --env-file-if-exists=.env src/cli.js retention-report",
    "load:check": "node src/load-check.js"
  },
  "dependencies": {
    "mysql2": "^3.24.6",
    "qrcode": "^1.5.4"
  }
}
